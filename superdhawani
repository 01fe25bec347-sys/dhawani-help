-- Dhawani production foundation for Supabase (PostgreSQL + Auth + RLS)
-- Run in Supabase SQL Editor. This schema does not itself connect the existing
-- index.html; the frontend integration is a separate required development step.

create extension if not exists pgcrypto;

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  display_name text not null default '',
  phone text,
  state text,
  city text,
  locality text,
  role text not null default 'citizen' check (role in ('citizen', 'official', 'admin')),
  official_status text not null default 'not_applicable'
    check (official_status in ('not_applicable', 'pending', 'approved', 'rejected')),
  department text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint profile_role_status_check check (
    (role = 'citizen' and official_status = 'not_applicable') or
    (role = 'official' and official_status in ('pending', 'approved', 'rejected')) or
    role = 'admin'
  )
);

create table if not exists public.complaints (
  id uuid primary key default gen_random_uuid(),
  ticket_code text not null unique default ('DHW-' || upper(substr(replace(gen_random_uuid()::text, '-', ''), 1, 8))),
  citizen_id uuid not null references public.profiles(id) on delete restrict,
  description text not null check (char_length(trim(description)) between 8 and 5000),
  language_code text not null default 'en',
  category text not null default 'other',
  location_text text,
  state text,
  city text,
  locality text,
  ward text,
  urgency text not null default 'medium' check (urgency in ('low', 'medium', 'high')),
  status text not null default 'registered'
    check (status in ('registered', 'assigned', 'in_progress', 'resolved', 'rejected')),
  department text,
  photo_path text,
  assigned_to uuid references public.profiles(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  resolved_at timestamptz
);

create table if not exists public.complaint_updates (
  id uuid primary key default gen_random_uuid(),
  complaint_id uuid not null references public.complaints(id) on delete cascade,
  actor_id uuid references public.profiles(id) on delete set null,
  old_status text,
  new_status text not null check (new_status in ('registered', 'assigned', 'in_progress', 'resolved', 'rejected')),
  public_note text not null default '',
  created_at timestamptz not null default now()
);

create index if not exists complaints_citizen_created_idx
  on public.complaints (citizen_id, created_at desc);
create index if not exists complaints_status_created_idx
  on public.complaints (status, created_at desc);
create index if not exists complaints_ticket_code_idx
  on public.complaints (ticket_code);
create index if not exists complaint_updates_complaint_created_idx
  on public.complaint_updates (complaint_id, created_at desc);

-- Helper functions use a fixed search_path to avoid search-path attacks.
create or replace function public.is_approved_official()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles p
    where p.id = auth.uid()
      and p.role in ('official', 'admin')
      and (p.role = 'admin' or p.official_status = 'approved')
  );
$$;

create or replace function public.is_dhawani_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles p
    where p.id = auth.uid() and p.role = 'admin'
  );
$$;

-- Create a citizen profile for each newly registered Auth user.
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.profiles (id, display_name)
  values (new.id, coalesce(new.raw_user_meta_data ->> 'display_name', ''))
  on conflict (id) do nothing;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created_dhawani on auth.users;
create trigger on_auth_user_created_dhawani
after insert on auth.users
for each row execute procedure public.handle_new_user();

-- Keep updated_at current.
create or replace function public.set_updated_at()
returns trigger
language plpgsql
set search_path = public
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

drop trigger if exists profiles_set_updated_at on public.profiles;
create trigger profiles_set_updated_at before update on public.profiles
for each row execute procedure public.set_updated_at();
drop trigger if exists complaints_set_updated_at on public.complaints;
create trigger complaints_set_updated_at before update on public.complaints
for each row execute procedure public.set_updated_at();

alter table public.profiles enable row level security;
alter table public.complaints enable row level security;
alter table public.complaint_updates enable row level security;

-- Profiles: users can see and edit their own ordinary profile fields.
drop policy if exists "profile_select_self_or_staff" on public.profiles;
create policy "profile_select_self_or_staff" on public.profiles
for select to authenticated
using (id = auth.uid() or public.is_approved_official());

drop policy if exists "profile_update_self" on public.profiles;
create policy "profile_update_self" on public.profiles
for update to authenticated
using (id = auth.uid())
with check (id = auth.uid());

-- Restrict column-level updates so users cannot grant themselves staff roles.
revoke update on public.profiles from authenticated;
grant update (display_name, phone, state, city, locality) on public.profiles to authenticated;
grant select on public.profiles to authenticated;

-- Complaint creation is citizen-only; citizens see their own, approved staff see all.
drop policy if exists "citizen_create_own_complaint" on public.complaints;
create policy "citizen_create_own_complaint" on public.complaints
for insert to authenticated
with check (
  citizen_id = auth.uid()
  and exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'citizen')
);

drop policy if exists "citizen_or_staff_read_complaints" on public.complaints;
create policy "citizen_or_staff_read_complaints" on public.complaints
for select to authenticated
using (citizen_id = auth.uid() or public.is_approved_official());

drop policy if exists "staff_update_complaints" on public.complaints;
create policy "staff_update_complaints" on public.complaints
for update to authenticated
using (public.is_approved_official())
with check (public.is_approved_official());

grant select on public.complaints to authenticated;
revoke insert on public.complaints from authenticated;
grant insert (citizen_id, description, language_code, category, location_text, state, city, locality, ward, urgency, photo_path)
  on public.complaints to authenticated;
grant update (status, department, assigned_to, urgency, resolved_at) on public.complaints to authenticated;

-- Updates: citizens may read the public timeline for their own complaints;
-- only approved staff may create timeline entries.
drop policy if exists "citizen_or_staff_read_updates" on public.complaint_updates;
create policy "citizen_or_staff_read_updates" on public.complaint_updates
for select to authenticated
using (
  public.is_approved_official() or exists (
    select 1 from public.complaints c
    where c.id = complaint_id and c.citizen_id = auth.uid()
  )
);

drop policy if exists "staff_create_updates" on public.complaint_updates;
create policy "staff_create_updates" on public.complaint_updates
for insert to authenticated
with check (public.is_approved_official() and actor_id = auth.uid());

grant select, insert on public.complaint_updates to authenticated;

